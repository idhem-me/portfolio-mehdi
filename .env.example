# --- PostHog (client) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# EU recommandé : https://eu.i.posthog.com | US : https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Lien console (bouton dashboard), ex. https://eu.posthog.com/project/123
NEXT_PUBLIC_POSTHOG_APP_URL=

# --- PostHog (serveur, dashboard KPI) ---
# Personal API Key : https://app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxx
POSTHOG_PROJECT_ID=12345

# --- Microsoft Clarity ---
NEXT_PUBLIC_CLARITY_ID=
# Lien console, ex. https://clarity.microsoft.com/projects/view/xxxxx
NEXT_PUBLIC_CLARITY_APP_URL=

# --- Vercel Web Analytics ---
# Pas de clé côté client : le package @vercel/analytics suffit après déploiement Vercel.
# Lien console (bouton dashboard), ex. https://vercel.com/.../analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_URL=

# --- Contact / retours jeux (Web3Forms — gratuit) ---
# 1. Va sur https://web3forms.com
# 2. Entre ton email → tu reçois une Access Key par mail
# 3. NEXT_PUBLIC_ obligatoire : l’envoi se fait depuis le navigateur
#    (le mode serveur Web3Forms est payant). Redémarre next après ajout.
# 4. Sur Vercel : même variable en Production + Redeploy
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Accès /dashboard ---
# Obligatoire aussi sur Vercel → Settings → Environment Variables (Production)
# Sans cette variable, /api/dashboard/login répond 503.
DASHBOARD_PASSWORD=change-me

# Lava is hidden by default. Enable only in .env.local.
NEXT_PUBLIC_ENABLE_TETRIS=false

NEXT_PUBLIC_ENABLE_TETRIS_SOUND=false
NEXT_PUBLIC_ENABLE_TETRIS_LEADERBOARD=false

# Adobe Spectrum design system — off by default.
NEXT_PUBLIC_ENABLE_ADOBE_DS=false

# Cards: enabled automatically in `next dev`. Production stays off unless:
NEXT_PUBLIC_ENABLE_CARDS=true

# Optional persistent leaderboard on Vercel (server-only, never NEXT_PUBLIC_).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Preferred persistent backend: existing Supabase project, server-only.
# Run supabase/migrations/202610250001_tetris_leaderboard.sql first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY: SUPABASE_SERVICE_ROLE_KEY

# Optional Google sign-in, server-only SSR client (public key, never secret key).
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: SUPABASE_ANON_KEY

# Existing Google OAuth Web client ID, also configured in Supabase.
GOOGLE_CLIENT_ID=

# Public anonymous Backoffice (server only; never NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
